/* ========================================
   GenericScope Dark Theme - Industrial Control
   ======================================== */

QMainWindow {
    background-color: #20262d;
}

QWidget#centralwidget {
    background-color: #20262d;
}

QWidget {
    font-family: "Segoe UI", "Microsoft YaHei UI", "微软雅黑", sans-serif;
    font-size: 9pt;
    color: #d4dde5;
    background-color: transparent;
}

QDialog {
    background-color: #20262d;
}

QWidget#titleBarWidget {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #23384e,
                                stop:1 #30506f);
    color: #eef3f7;
    border-bottom: 2px solid #1b2d3e;
}

QWidget#titleBarWidget QLabel {
    color: #eef3f7;
    font-weight: 700;
}

QWidget#titleBarWidget QLabel#titleLabel {
    font-size: 11pt;
    font-weight: 700;
}

QWidget#controlBarWidget {
    background-color: #262d35;
    border-bottom: 1px solid #3b4651;
    padding: 8px;
}

QPushButton {
    background-color: #3f6e99;
    color: #f4f7fa;
    border: 1px solid #335879;
    border-radius: 5px;
    padding: 8px 16px;
    font-size: 9pt;
    font-weight: 700;
    min-height: 28px;
}

QPushButton:hover {
    background-color: #4b7ba8;
}

QPushButton:pressed {
    background-color: #345f86;
}

QPushButton:checked {
    background-color: #824444;
    border-color: #6d3838;
}

QPushButton:disabled {
    background-color: #333b44;
    color: #7d8894;
    border-color: #49535d;
}

QPushButton#secondaryButton {
    background-color: #313941;
    color: #d6e0e8;
    border: 1px solid #637487;
}

QPushButton#secondaryButton:hover {
    background-color: #39434d;
}

QPushButton#secondaryButton:pressed {
    background-color: #2a323a;
}

QPushButton#successButton {
    background-color: #466c52;
    border-color: #3a5a44;
}

QPushButton#successButton:hover {
    background-color: #548162;
}

QPushButton#dangerButton {
    background-color: #9c5353;
    border-color: #824444;
}

QPushButton#dangerButton:hover {
    background-color: #ad5f5f;
}

QComboBox,
QLineEdit,
QSpinBox,
QDoubleSpinBox,
QTextEdit,
QPlainTextEdit {
    font-size: 9pt;
    color: #d9e1e8;
    border: 1px solid #566573;
    border-radius: 4px;
    padding: 6px 10px;
    background-color: #2a3139;
    selection-background-color: #3f6e99;
    selection-color: #ffffff;
}

QComboBox,
QLineEdit,
QSpinBox,
QDoubleSpinBox {
    min-height: 28px;
}

QComboBox:hover,
QLineEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QTextEdit:hover,
QPlainTextEdit:hover {
    border-color: #6a7a89;
    background-color: #303844;
}

QComboBox:focus,
QLineEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border-color: #6d95bf;
    background-color: #303844;
}

QComboBox:disabled,
QLineEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled {
    background-color: #232930;
    color: #7f8b96;
    border-color: #48525c;
}

QComboBox::drop-down,
QSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button {
    border: none;
    background: transparent;
    width: 24px;
}

QComboBox QAbstractItemView,
QAbstractItemView {
    border: 1px solid #64778a;
    background-color: #2d353f;
    selection-background-color: #43586f;
    selection-color: #eef3f7;
    outline: none;
}

QCheckBox,
QRadioButton {
    spacing: 8px;
    color: #d4dde5;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #748494;
    background-color: #2a3139;
}

QCheckBox::indicator {
    border-radius: 3px;
}

QRadioButton::indicator {
    border-radius: 9px;
}

QCheckBox::indicator:checked,
QRadioButton::indicator:checked {
    background-color: #4a7aa5;
    border-color: #4a7aa5;
}

QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 6px;
    color: #edf2f6;
    min-width: 30px;
    min-height: 30px;
}

QToolButton:hover {
    background-color: rgba(109, 149, 191, 0.16);
}

QWidget#controlBarWidget QToolButton {
    color: #9dafbf;
}

QWidget#controlBarWidget QToolButton:hover {
    background-color: #313942;
    border-color: #4a5661;
    color: #7fb0dd;
}

QTableWidget,
QTableView,
QTreeView,
QListView {
    background-color: #262d35;
    alternate-background-color: #2b333d;
    border: 1px solid #55616d;
    border-radius: 6px;
    gridline-color: #3a4550;
    color: #d6dee6;
    selection-background-color: #42596f;
    selection-color: #eef3f7;
}

QTableWidget::item,
QTableView::item,
QTreeView::item,
QListView::item {
    padding: 8px;
    border: none;
}

QHeaderView::section {
    background-color: #313a44;
    color: #e0e7ee;
    font-weight: 700;
    padding: 10px 8px;
    border: none;
    border-bottom: 1px solid #55616d;
    border-right: 1px solid #46515d;
}

QGroupBox {
    border: 1px solid #56626e;
    border-radius: 8px;
    margin-top: 16px;
    padding-top: 12px;
    font-weight: 700;
    color: #dce4eb;
    background-color: #252c34;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    padding: 0 8px;
    color: #87b2db;
    background-color: #20262d;
}

QMenu,
QMenuBar,
QToolBar,
QStatusBar {
    background-color: #262d35;
    color: #d4dde5;
    border-color: #4d5965;
}

QStatusBar {
    border-top: 1px solid #4d5965;
}

QProgressBar {
    border: 1px solid #56626e;
    border-radius: 4px;
    background-color: #2f3740;
    text-align: center;
    color: #dce4eb;
}

QProgressBar::chunk {
    background-color: #4a7aa5;
    border-radius: 3px;
}

QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollBar:vertical,
QScrollBar:horizontal {
    background-color: #313942;
    border: none;
    margin: 2px;
}

QScrollBar:vertical { width: 12px; }
QScrollBar:horizontal { height: 12px; }

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background-color: #647484;
    border-radius: 5px;
    min-height: 24px;
    min-width: 24px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background-color: #7a8c9c;
}

QLabel#connectionStatusLabel,
QLabel#currentStatusLabel {
    font-size: 10pt;
    font-weight: 700;
    border: 1px solid #56626e;
    border-radius: 6px;
    padding: 5px 10px;
    background-color: #313942;
}

QLabel#connectionStatusLabel[state="connected"],
QLabel#currentStatusLabel[state="connected"],
QLabel#currentStatusLabel[state="success"] {
    color: #9fd0ac;
    background-color: #31453a;
    border-color: #587164;
}

QLabel#connectionStatusLabel[state="error"],
QLabel#currentStatusLabel[state="error"],
QLabel#currentStatusLabel[state="off"] {
    color: #e09a9a;
    background-color: #4a3232;
    border-color: #7d5c5c;
}

QLabel#currentStatusLabel[state="warning"],
QLabel#currentStatusLabel[state="running"] {
    color: #dbe4ec;
    background-color: #36424e;
    border-color: #617383;
}

QLabel#errorLabel {
    color: #d97979;
}

QLabel#successLabel {
    color: #8cc39b;
}

QLabel#warningLabel {
    color: #d3b06c;
}

QLabel#secondaryLabel {
    color: #9aaaba;
}

QWidget#leftPanel,
QWidget#centerPanel,
QWidget#rightPanel,
QWidget#visualization3DContainer,
QWidget#chartContainer,
QFrame#monitorChart,
QDialog#turntableControlDialog,
QDialog#ovenControlDialog,
LogWidget {
    background-color: #252c34;
    border: 1px solid #56626e;
    border-radius: 8px;
}
