/* ========================================
   GenericScope Light Theme - Modern Design
   配色方案：清新、专业、高对比度
   ======================================== */

/* ========== 配色变量（注释） ==========
   主色：#2196F3 (蓝色)
   主色深：#1976D2
   主色浅：#E3F2FD
   成功色：#4CAF50
   错误色：#F44336
   警告色：#FF9800

   背景：#FAFAFA
   表面：#FFFFFF
   边框：#E0E0E0
   文本主：#212121
   文本次：#757575
   文本禁用：#BDBDBD
*/

/* ========== 全局样式 ========== */
QMainWindow {
    background-color: #FAFAFA;
}

QMainWindow::centralwidget {
    background-color: #FAFAFA;
}

QWidget {
    font-family: "Segoe UI", "Microsoft YaHei UI", "微软雅黑", sans-serif;
    font-size: 9pt;
    color: #212121;
    background-color: transparent;
}

/* ========== 标题栏 ========== */
QWidget#titleBarWidget {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #1565C0,
                                stop:1 #1976D2);
    color: #FFFFFF;
    border-bottom: 2px solid #0D47A1;
}

QWidget#titleBarWidget QLabel {
    color: #FFFFFF;
    font-weight: 600;
}

QWidget#titleBarWidget QLabel#titleLabel {
    font-size: 11pt;
    font-weight: 700;
}

/* ========== 控制栏 ========== */
QWidget#controlBarWidget {
    background-color: #FFFFFF;
    border-bottom: 2px solid #E0E0E0;
    padding: 8px;
}

/* ========== 按钮 - 现代扁平化设计 ========== */
QPushButton {
    background-color: #2196F3;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-size: 9pt;
    font-weight: 500;
    min-height: 28px;
}

QPushButton:hover {
    background-color: #1E88E5;
}

QPushButton:pressed {
    background-color: #1976D2;
}

QPushButton:checked {
    background-color: #F44336;
}

QPushButton:checked:hover {
    background-color: #E53935;
}

QPushButton:disabled {
    background-color: #E0E0E0;
    color: #9E9E9E;
}

/* 次要按钮 */
QPushButton#secondaryButton {
    background-color: #FFFFFF;
    color: #2196F3;
    border: 2px solid #2196F3;
}

QPushButton#secondaryButton:hover {
    background-color: #E3F2FD;
}

QPushButton#secondaryButton:pressed {
    background-color: #BBDEFB;
}

/* 成功按钮 */
QPushButton#successButton {
    background-color: #4CAF50;
}

QPushButton#successButton:hover {
    background-color: #43A047;
}

/* 危险按钮 */
QPushButton#dangerButton {
    background-color: #F44336;
}

QPushButton#dangerButton:hover {
    background-color: #E53935;
}

/* ========== 下拉框 ========== */
QComboBox {
    border: 2px solid #E0E0E0;
    border-radius: 6px;
    padding: 6px 12px;
    background-color: #FFFFFF;
    color: #212121;
    min-height: 28px;
}

QComboBox:hover {
    border-color: #BDBDBD;
}

QComboBox:focus {
    border-color: #2196F3;
}

QComboBox:disabled {
    background-color: #F5F5F5;
    color: #9E9E9E;
    border-color: #EEEEEE;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
    padding-right: 4px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #757575;
    width: 0;
    height: 0;
}

QComboBox::down-arrow:hover {
    border-top-color: #2196F3;
}

QComboBox QAbstractItemView {
    border: 2px solid #2196F3;
    border-radius: 6px;
    background-color: #FFFFFF;
    selection-background-color: #2196F3;
    selection-color: #FFFFFF;
    outline: none;
    padding: 4px;
}

QComboBox QAbstractItemView::item {
    padding: 6px 12px;
    border-radius: 4px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #E3F2FD;
    color: #212121;
}

/* ========== 输入框 ========== */
QLineEdit, QSpinBox {
    border: 2px solid #E0E0E0;
    border-radius: 6px;
    padding: 6px 12px;
    background-color: #FFFFFF;
    color: #212121;
    min-height: 28px;
    selection-background-color: #2196F3;
    selection-color: #FFFFFF;
}

QLineEdit:hover, QSpinBox:hover {
    border-color: #BDBDBD;
}

QLineEdit:focus, QSpinBox:focus {
    border-color: #2196F3;
}

QLineEdit:disabled, QSpinBox:disabled {
    background-color: #F5F5F5;
    color: #9E9E9E;
    border-color: #EEEEEE;
}

/* ========== 复选框 - 现代圆角设计 ========== */
QCheckBox {
    spacing: 8px;
    color: #212121;
}

QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border: 2px solid #BDBDBD;
    border-radius: 4px;
    background-color: #FFFFFF;
}

QCheckBox::indicator:hover {
    border-color: #2196F3;
}

QCheckBox::indicator:checked {
    background-color: #2196F3;
    border-color: #2196F3;
    image: none;
}

QCheckBox::indicator:checked:hover {
    background-color: #1E88E5;
}

QCheckBox::indicator:disabled {
    background-color: #F5F5F5;
    border-color: #E0E0E0;
}

/* ========== 单选框 ========== */
QRadioButton {
    spacing: 8px;
    color: #212121;
}

QRadioButton::indicator {
    width: 20px;
    height: 20px;
    border: 2px solid #BDBDBD;
    border-radius: 10px;
    background-color: #FFFFFF;
}

QRadioButton::indicator:hover {
    border-color: #2196F3;
}

QRadioButton::indicator:checked {
    background-color: #FFFFFF;
    border-color: #2196F3;
    border-width: 6px;
}

/* ========== 工具按钮 ========== */
QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 6px;
    color: #FFFFFF;
    min-width: 32px;
    min-height: 32px;
}

QToolButton:hover {
    background-color: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.25);
}

QToolButton:pressed {
    background-color: rgba(255, 255, 255, 0.25);
}

QToolButton:checked {
    background-color: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.3);
}

/* 控制栏中的工具按钮 */
QWidget#controlBarWidget QToolButton {
    color: #757575;
}

QWidget#controlBarWidget QToolButton:hover {
    background-color: #F5F5F5;
    border-color: #E0E0E0;
    color: #2196F3;
}

QWidget#controlBarWidget QToolButton:pressed {
    background-color: #EEEEEE;
}

QWidget#controlBarWidget QToolButton:checked {
    background-color: #E3F2FD;
    color: #2196F3;
}

/* ========== 表格 - 专业数据表格样式 ========== */
QTableWidget {
    gridline-color: #E0E0E0;
    background-color: #FFFFFF;
    alternate-background-color: #F9F9F9;
    border: 1px solid #E0E0E0;
    border-radius: 8px;
    selection-background-color: #E3F2FD;
    selection-color: #212121;
}

QTableWidget::item {
    padding: 8px;
    border: none;
}

QTableWidget::item:selected {
    background-color: #E3F2FD;
    color: #1976D2;
}

QTableWidget::item:hover {
    background-color: #F5F5F5;
}

QTableWidget::item:selected:hover {
    background-color: #BBDEFB;
}

QHeaderView::section {
    background-color: #F5F5F5;
    padding: 10px 8px;
    border: none;
    border-bottom: 2px solid #2196F3;
    border-right: 1px solid #E0E0E0;
    font-weight: 600;
    color: #616161;
    text-align: left;
}

QHeaderView::section:hover {
    background-color: #EEEEEE;
    color: #2196F3;
}

QHeaderView::section:first {
    border-top-left-radius: 8px;
}

QHeaderView::section:last {
    border-top-right-radius: 8px;
    border-right: none;
}

/* ========== 分组框 ========== */
QGroupBox {
    border: 2px solid #E0E0E0;
    border-radius: 8px;
    margin-top: 16px;
    font-weight: 600;
    padding-top: 16px;
    color: #424242;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 4px 12px;
    background-color: #FFFFFF;
    color: #2196F3;
    font-size: 10pt;
    border-radius: 4px;
    left: 12px;
}

/* ========== 滚动条 - 精致设计 ========== */
QScrollBar:vertical {
    border: none;
    background-color: #F5F5F5;
    width: 14px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: #BDBDBD;
    border-radius: 6px;
    min-height: 30px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #9E9E9E;
}

QScrollBar::handle:vertical:pressed {
    background-color: #757575;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    border: none;
    background-color: #F5F5F5;
    height: 14px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background-color: #BDBDBD;
    border-radius: 6px;
    min-width: 30px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #9E9E9E;
}

QScrollBar::handle:horizontal:pressed {
    background-color: #757575;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* ========== 分隔器 ========== */
QSplitter::handle {
    background-color: #E0E0E0;
    width: 2px;
    height: 2px;
}

QSplitter::handle:hover {
    background-color: #2196F3;
}

QSplitter::handle:pressed {
    background-color: #1976D2;
}

/* ========== 标签页 ========== */
QTabWidget::pane {
    border: 2px solid #E0E0E0;
    border-radius: 8px;
    background-color: #FFFFFF;
    top: -2px;
}

QTabBar::tab {
    background-color: #F5F5F5;
    color: #757575;
    border: 2px solid #E0E0E0;
    border-bottom: none;
    padding: 8px 16px;
    margin-right: 4px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    min-width: 80px;
}

QTabBar::tab:hover {
    background-color: #EEEEEE;
    color: #424242;
}

QTabBar::tab:selected {
    background-color: #FFFFFF;
    color: #2196F3;
    font-weight: 600;
    border-color: #E0E0E0;
    border-bottom: 2px solid #FFFFFF;
}

QTabBar::tab:!selected {
    margin-top: 4px;
}

/* ========== 进度条 ========== */
QProgressBar {
    background-color: #E0E0E0;
    border: none;
    border-radius: 6px;
    text-align: center;
    height: 24px;
    color: #212121;
    font-weight: 600;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #2196F3,
                                stop:1 #21CBF3);
    border-radius: 6px;
}

/* ========== 状态栏 ========== */
QStatusBar {
    background-color: #F5F5F5;
    border-top: 1px solid #E0E0E0;
    color: #616161;
}

/* ========== 菜单 ========== */
QMenu {
    background-color: #FFFFFF;
    border: 2px solid #E0E0E0;
    border-radius: 8px;
    padding: 8px;
}

QMenu::item {
    padding: 8px 32px 8px 16px;
    border-radius: 6px;
    color: #212121;
}

QMenu::item:selected {
    background-color: #2196F3;
    color: #FFFFFF;
}

QMenu::item:disabled {
    color: #BDBDBD;
}

QMenu::separator {
    height: 1px;
    background-color: #E0E0E0;
    margin: 8px 12px;
}

QMenu::icon {
    padding-left: 8px;
}

/* ========== 菜单栏 ========== */
QMenuBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E0E0E0;
    spacing: 4px;
}

QMenuBar::item {
    padding: 6px 12px;
    background-color: transparent;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #E3F2FD;
    color: #2196F3;
}

QMenuBar::item:pressed {
    background-color: #BBDEFB;
}

/* ========== 工具栏 ========== */
QToolBar {
    background-color: #F5F5F5;
    border: none;
    spacing: 4px;
    padding: 4px;
}

QToolBar::separator {
    background-color: #E0E0E0;
    width: 1px;
    margin: 4px 8px;
}

/* ========== 标签 ========== */
QLabel {
    color: #212121;
    background-color: transparent;
}

QLabel#secondaryLabel {
    color: #757575;
}

QLabel#errorLabel {
    color: #F44336;
    font-weight: 600;
}

QLabel#successLabel {
    color: #4CAF50;
    font-weight: 600;
}

QLabel#warningLabel {
    color: #FF9800;
    font-weight: 600;
}

/* ========== 面板样式 ========== */
QWidget#leftPanel,
QWidget#centerPanel,
QWidget#rightPanel {
    background-color: #FFFFFF;
    border-radius: 8px;
    border: 1px solid #E0E0E0;
}

/* ========== 自定义控件 ========== */
QWidget#attitudeWidget {
    background-color: #FAFAFA;
    border: 1px solid #E0E0E0;
    border-radius: 8px;
}

QWidget#chartParamsWidget {
    background-color: transparent;
}

QWidget#timestampWidget {
    background-color: transparent;
}

QWidget#filterToolbar {
    background-color: #FFFFFF;
    border: none;
    border-radius: 4px;
}

/* 3D可视化容器 */
QWidget#visualization3DContainer {
    background-color: #F5F5F5;
    border: 1px solid #E0E0E0;
    border-radius: 8px;
}

/* 图表容器 */
QWidget#chartContainer {
    background-color: #F5F5F5;
    border: 1px solid #E0E0E0;
    border-radius: 8px;
}

/* ========== 提示框 ========== */
QToolTip {
    background-color: #424242;
    color: #FFFFFF;
    border: 1px solid #616161;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 9pt;
}

/* ========== 对话框 ========== */
QDialog {
    background-color: #FAFAFA;
}

/* ========== 文本编辑器 ========== */
QTextEdit, QPlainTextEdit {
    background-color: #FFFFFF;
    border: 2px solid #E0E0E0;
    border-radius: 6px;
    color: #212121;
    selection-background-color: #2196F3;
    selection-color: #FFFFFF;
    padding: 8px;
}

QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #2196F3;
}

/* ========== 滑块 ========== */
QSlider::groove:horizontal {
    background-color: #E0E0E0;
    height: 6px;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background-color: #2196F3;
    width: 18px;
    height: 18px;
    margin: -6px 0;
    border-radius: 9px;
}

QSlider::handle:horizontal:hover {
    background-color: #1E88E5;
}

QSlider::handle:horizontal:pressed {
    background-color: #1976D2;
}

/* ========== 树形视图 ========== */
QTreeView {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 8px;
    selection-background-color: #E3F2FD;
    selection-color: #212121;
}

QTreeView::item {
    padding: 4px;
}

QTreeView::item:hover {
    background-color: #F5F5F5;
}

QTreeView::item:selected {
    background-color: #E3F2FD;
    color: #1976D2;
}

QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    border-image: none;
    image: none;
}

QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    border-image: none;
    image: none;
}

/* ========== 列表视图 ========== */
QListView {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 8px;
    selection-background-color: #E3F2FD;
    selection-color: #212121;
}

QListView::item {
    padding: 8px;
    border-radius: 4px;
}

QListView::item:hover {
    background-color: #F5F5F5;
}

QListView::item:selected {
    background-color: #E3F2FD;
    color: #1976D2;
}

/* ========== LogWidget 专用样式 ========== */
LogWidget {
    background-color: #FFFFFF;
}

LogWidget QTextEdit {
    background-color: #ffffff;
    color: #212121;
    border: 1px solid #ddd;
    border-radius: 4px;
}

LogWidget QComboBox {
    background-color: #FFFFFF;
    color: #212121;
    border: 1px solid #E0E0E0;
}

LogWidget QPushButton {
    background-color: #2196F3;
    color: #FFFFFF;
}
