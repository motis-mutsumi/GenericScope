/* ========================================
   GenericScope Light Theme - Industrial Control
   ======================================== */

QMainWindow {
    background-color: #e9edf2;
}

QWidget#centralwidget {
    background-color: #e9edf2;
}

QWidget {
    font-family: "Segoe UI", "Microsoft YaHei UI", "微软雅黑", sans-serif;
    font-size: 9pt;
    color: #23384d;
    background-color: transparent;
}

QDialog {
    background-color: #e9edf2;
}

QWidget#titleBarWidget {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #274766,
                                stop:1 #356289);
    color: #F4F7FA;
    border-bottom: 2px solid #203950;
}

QWidget#titleBarWidget QLabel {
    color: #F4F7FA;
    font-weight: 700;
}

QWidget#titleBarWidget QLabel#titleLabel {
    font-size: 11pt;
    font-weight: 700;
}

QWidget#controlBarWidget {
    background-color: #f5f8fb;
    border-bottom: 1px solid #b7c3cf;
    padding: 8px;
}

QPushButton {
    background-color: #2f5d87;
    color: #ffffff;
    border: 1px solid #244866;
    border-radius: 5px;
    padding: 8px 16px;
    font-size: 9pt;
    font-weight: 700;
    min-height: 28px;
}

QPushButton:hover {
    background-color: #3b6d99;
}

QPushButton:pressed {
    background-color: #234968;
}

QPushButton:checked {
    background-color: #7d2a2a;
    border-color: #672121;
}

QPushButton:disabled {
    background-color: #cfd7df;
    color: #7a8794;
    border-color: #b3bec9;
}

QPushButton#secondaryButton {
    background-color: #d9e1e9;
    color: #18344d;
    border: 1px solid #97a8b8;
}

QPushButton#secondaryButton:hover {
    background-color: #cfd9e3;
}

QPushButton#secondaryButton:pressed {
    background-color: #c2ced9;
}

QPushButton#successButton {
    background-color: #4d7f5b;
    border-color: #40694b;
}

QPushButton#successButton:hover {
    background-color: #5a9269;
}

QPushButton#dangerButton {
    background-color: #b55050;
    border-color: #944141;
}

QPushButton#dangerButton:hover {
    background-color: #c86161;
}

QComboBox,
QLineEdit,
QSpinBox,
QDoubleSpinBox,
QTextEdit,
QPlainTextEdit {
    font-size: 9pt;
    color: #162838;
    border: 1px solid #9eacbb;
    border-radius: 4px;
    padding: 6px 10px;
    background-color: #ffffff;
    selection-background-color: #2f5d87;
    selection-color: #ffffff;
}

QComboBox,
QLineEdit,
QSpinBox,
QDoubleSpinBox {
    min-height: 28px;
}

QComboBox:hover,
QLineEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QTextEdit:hover,
QPlainTextEdit:hover {
    border-color: #8698aa;
}

QComboBox:focus,
QLineEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border-color: #2f5d87;
    background-color: #fdfefe;
}

QComboBox:disabled,
QLineEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled {
    background-color: #edf1f4;
    color: #7d8894;
    border-color: #c2ccd5;
}

QComboBox::drop-down,
QSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button {
    border: none;
    background: transparent;
    width: 24px;
}

QComboBox QAbstractItemView,
QAbstractItemView {
    border: 1px solid #97a8b8;
    background-color: #fdfefe;
    selection-background-color: #d8e1ea;
    selection-color: #18344d;
    outline: none;
}

QCheckBox,
QRadioButton {
    spacing: 8px;
    color: #23384d;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #8da0b2;
    background-color: #ffffff;
}

QCheckBox::indicator {
    border-radius: 3px;
}

QRadioButton::indicator {
    border-radius: 9px;
}

QCheckBox::indicator:checked,
QRadioButton::indicator:checked {
    background-color: #2f5d87;
    border-color: #2f5d87;
}

QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 6px;
    color: #f2f6f9;
    min-width: 30px;
    min-height: 30px;
}

QToolButton:hover {
    background-color: rgba(255, 255, 255, 0.12);
}

QWidget#controlBarWidget QToolButton {
    color: #5b6c7d;
}

QWidget#controlBarWidget QToolButton:hover {
    background-color: #e5ebf1;
    border-color: #c3cdd6;
    color: #2f5d87;
}

QTableWidget,
QTableView,
QTreeView,
QListView {
    background-color: #fdfefe;
    alternate-background-color: #eef3f7;
    border: 1px solid #b7c3cf;
    border-radius: 6px;
    gridline-color: #d8e1ea;
    color: #1c3246;
    selection-background-color: #d8e1ea;
    selection-color: #18344d;
}

QTableWidget::item,
QTableView::item,
QTreeView::item,
QListView::item {
    padding: 8px;
    border: none;
}

QHeaderView::section {
    background-color: #d8e1ea;
    color: #1d3348;
    font-weight: 700;
    padding: 10px 8px;
    border: none;
    border-bottom: 1px solid #aebbc8;
    border-right: 1px solid #c8d2db;
}

QGroupBox {
    border: 1px solid #aebbc8;
    border-radius: 8px;
    margin-top: 16px;
    padding-top: 12px;
    font-weight: 700;
    color: #14324a;
    background-color: #f7f9fb;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    padding: 0 8px;
    color: #0f4c81;
    background-color: #e9edf2;
}

QMenu,
QMenuBar,
QToolBar,
QStatusBar {
    background-color: #f4f7fa;
    color: #23384d;
    border-color: #c2ccd5;
}

QStatusBar {
    border-top: 1px solid #c2ccd5;
}

QProgressBar {
    border: 1px solid #9eb0c0;
    border-radius: 4px;
    background-color: #e3e9ef;
    text-align: center;
    color: #18344d;
}

QProgressBar::chunk {
    background-color: #2f5d87;
    border-radius: 3px;
}

QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollBar:vertical,
QScrollBar:horizontal {
    background-color: #dde4eb;
    border: none;
    margin: 2px;
}

QScrollBar:vertical { width: 12px; }
QScrollBar:horizontal { height: 12px; }

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background-color: #9eb0c0;
    border-radius: 5px;
    min-height: 24px;
    min-width: 24px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background-color: #8799ab;
}

QLabel#connectionStatusLabel,
QLabel#currentStatusLabel {
    font-size: 10pt;
    font-weight: 700;
    border: 1px solid #aebbc8;
    border-radius: 6px;
    padding: 5px 10px;
    background-color: #dfe6ed;
}

QLabel#connectionStatusLabel[state="connected"],
QLabel#currentStatusLabel[state="connected"],
QLabel#currentStatusLabel[state="success"] {
    color: #0f5132;
    background-color: #d7e8db;
    border-color: #8fad97;
}

QLabel#connectionStatusLabel[state="error"],
QLabel#currentStatusLabel[state="error"],
QLabel#currentStatusLabel[state="off"] {
    color: #7a1f1f;
    background-color: #f1d5d5;
    border-color: #c58c8c;
}

QLabel#currentStatusLabel[state="warning"],
QLabel#currentStatusLabel[state="running"] {
    color: #1d3348;
    background-color: #e7edf3;
    border-color: #9fb1c0;
}

QLabel#errorLabel {
    color: #9b2d2d;
}

QLabel#successLabel {
    color: #356846;
}

QLabel#warningLabel {
    color: #8a5b16;
}

QLabel#secondaryLabel {
    color: #5f7184;
}

QWidget#leftPanel,
QWidget#centerPanel,
QWidget#rightPanel,
QWidget#visualization3DContainer,
QWidget#chartContainer,
QFrame#monitorChart,
QDialog#turntableControlDialog,
QDialog#ovenControlDialog,
LogWidget {
    background-color: #f7f9fb;
    border: 1px solid #b7c3cf;
    border-radius: 8px;
}
